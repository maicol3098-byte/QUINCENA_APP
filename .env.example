# PostgreSQL connection string. On Railway set this on the app service to ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/quincena
# "production" makes the sign-in cookie HTTPS-only. Set it on Railway.
NODE_ENV=development
# false: only the first account can sign itself up; an administrator adds everyone else.
# true: anyone with the link can create an account.
ALLOW_SIGNUP=false
# Railway sets PORT for you.
PORT=3000
